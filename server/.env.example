# Copy to .env and fill in. Never commit .env.
# Neon: Dashboard → Connect, or `neon env pull`.
# Pooled connection (host has "-pooler") for the running app:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional direct connection for schema changes (npm run db:reset).
# If left out, it's derived from DATABASE_URL by dropping "-pooler".
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Only for `npm test`, which ERASES the database it uses. Point it at a throwaway Neon branch.
# TEST_DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
PORT=3000
# Where the front end runs (comma-separated). GitHub Pages: https://jody2905.github.io
CORS_ORIGIN=http://localhost:3000,https://jody2905.github.io
# Lets clients pick a screening scenario (clear/registry/watchlist). Turn off in production.
DEMO_MODE=true
