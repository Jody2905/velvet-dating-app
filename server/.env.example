# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://velvet:velvet@localhost:5432/velvet
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
PORT=3000
# Where the front end runs (comma-separated). GitHub Pages: https://jody2905.github.io
CORS_ORIGIN=http://localhost:5500,https://jody2905.github.io
# Lets clients pick a screening scenario (clear/registry/watchlist). Turn off in production.
DEMO_MODE=true
